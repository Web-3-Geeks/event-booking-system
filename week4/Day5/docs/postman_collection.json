        {
          "name": "Double Cancellation",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings/6ab2f0cfcbf3e0ce4daddcd9/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings",
                "6ab2f0cfcbf3e0ce4daddcd9",
                "cancel"
              ]
            },
            "description": "Demonstrates that cancelling an already-CANCELLED booking is safely rejected (400) and does not restore seats a second time — verified this also holds under true concurrent load (see docs/CONCURRENCY-NOTES.md)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
